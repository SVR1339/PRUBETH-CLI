# PRUBETH AI — Factory Default Environment Configuration
# Copy this file to .env and insert your private API keys if using cloud providers.

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenRouter Free/Pro Tier Key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Anthropic Claude API Key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Local Offline Engine Endpoints (Zero Cloud Costs)
OLLAMA_HOST=http://localhost:11434
LM_STUDIO_URL=http://localhost:1234/v1
